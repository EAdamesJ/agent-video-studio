# Runtime
AVS_DATA_DIR=./data
AVS_HOST=127.0.0.1
AVS_PORT=8787
AVS_LOG_LEVEL=INFO

# Text provider preset: deepseek, anthropic, openai-compatible, or custom
AVS_TEXT_PROVIDER=deepseek
AVS_TEXT_MODEL=
AVS_TEXT_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
AVS_TEXT_API_KEY=

# Optional stock media
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional speech/transcription
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AVS_TTS_PROVIDER=edge
AVS_TRANSCRIPTION_PROVIDER=local

# Optional publishing. Supply only tokens/configuration for integrations you use.
YOUTUBE_CLIENT_SECRET_FILE=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_HOST=graph.instagram.com
AVS_META_GRAPH_VERSION=
AVS_PUBLIC_MEDIA_BASE_URL=
