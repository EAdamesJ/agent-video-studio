# Runtime
AVS_DATA_DIR=./data
AVS_HOST=127.0.0.1
AVS_PORT=8787
AVS_LOG_LEVEL=INFO

# Text provider preset: deepseek, anthropic, openai-compatible, or custom
AVS_TEXT_PROVIDER=deepseek
AVS_TEXT_MODEL=
AVS_TEXT_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional stock media
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional speech/transcription
ELEVENLABS_API_KEY=
AVS_TRANSCRIPTION_PROVIDER=local

# Optional publishing. Supply only tokens/configuration for integrations you use.
YOUTUBE_CLIENT_SECRET_FILE=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_ACCOUNT_ID=
